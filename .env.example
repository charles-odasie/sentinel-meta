# Sentinel — copy to .env (gitignored) or export in your shell. Never commit real keys.

# Primary: Muse Spark Open (open weights) on Baseten Model APIs — https://app.baseten.co
BASETEN_API_KEY=

# Optional: Muse Glimmer 30B (open weights) on Fireworks for fast steps — https://fireworks.ai
FIREWORKS_API_KEY=

# Optional fallback only: Meta Model API (hosted muse-spark-1.3, NOT open-weight) — https://dev.meta.ai
MODEL_API_KEY=

# Routing overrides (baseten | fireworks | meta). Defaults: reasoner=baseten, fast=fireworks (if key) else reasoner.
# SENTINEL_REASONER=baseten
# SENTINEL_FAST=fireworks

# Model overrides (defaults shown)
# SENTINEL_BASETEN_MODEL=meta-models/muse-spark-open
# SENTINEL_FIREWORKS_MODEL=accounts/fireworks/models/muse-glimmer-30b
# SENTINEL_META_MODEL=muse-spark-1.3

# Set to 1 to disable the network-namespace sandbox (the Privacy Receipt will say "sandbox: NONE")
# SENTINEL_NO_SANDBOX=0
