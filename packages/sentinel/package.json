{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Private, agentic bug reproducer on Meta Muse open-weight models: log in, failing test + verified fix + suspect commit + Privacy Receipt out.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sentinel": "./bin/sentinel.js"
  },
  "scripts": {
    "sentinel": "tsx src/cli.ts",
    "smoke": "tsx src/smoke.ts",
    "bench": "tsx src/bench/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dryrun": "tsx src/dryrun.ts"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
